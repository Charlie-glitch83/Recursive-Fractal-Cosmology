"## 4. Downstream and legacy module runner\n",
"\n",
"Modules A-F and H-Q remain usable as downstream projections. They consume the frozen packet. They do not choose it."
]
},
{
"cell_type": "code",
"execution_count": null,
"metadata": {},
"outputs": [],
"source": [
"def run_downstream_module(cfg):\n",
"    mod = cfg.get("module", "UNKNOWN")\n",
"    display(Markdown(f"## Module {mod}: {cfg.get('description', '')}"))\n",
"    print_claim_boundary(cfg)\n",
"\n",
"    dt = cfg.get("dt", 0.1)\n",
"    tmin, tmax = cfg.get("t_range", [0, packet_value("cycleLength", 60)])\n",
"    if tmax <= tmin:\n",
"        tmax = tmin + 60\n",
"    t_vals = np.arange(tmin, tmax, dt)\n",
"    if len(t_vals) < 2:\n",
"        t_vals = np.linspace(tmin, tmax, 100)\n",
"\n",
"    delta = cfg.get("delta", packet_value("delta", 4.6692))\n",
"    alpha = cfg.get("alpha", packet_value("alpha", 0.0256831))\n",
"    nu = cfg.get("nu", packet_value("nu", 0.00420784))\n",
"    n = cfg.get("nFullCanonical", packet_value("nFullCanonical", 40))\n",
"\n",
"    # Specialized lightweight downstream views\n",
"    if mod == "A":\n",
"        lam = cfg.get("lambdaNormalized", packet_value("lambdaNormalized", 0.489442))\n",
"        a = np.zeros_like(t_vals)\n",
"        adot = np.zeros_like(t_vals)\n",
"        a[0] = cfg.get("initial_conditions", {}).get("a(0)", 1.0)\n",
"        adot[0] = cfg.get("initial_conditions", {}).get("a'(0)", 0.0)\n",
"        for i in range(1, len(t_vals)):\n",
"            ti = t_vals[i - 1]\n",
"            sum_term = sum(np.exp(-alpha * j * ti) / (delta ** j) for j in range(1, int(packet_value("nClosure", 18)) + 1))\n",
"            psi_chi = 0.002 * np.cos(0.1 * ti) + 0.001 * np.sin(0.2 * ti)\n",
"            gamma_zeta = packet_value("epsilon", 0.000108071) * np.exp(-alpha * ti) + 0.0005 * np.cos(0.03 * ti)\n",
"            acc = -lam * (a[i - 1] ** 3) + sum_term + psi_chi + gamma_zeta\n",
"            adot[i] = adot[i - 1] + acc * dt\n",
"            a[i] = a[i - 1] + adot[i] * dt\n",
"        plt.figure(figsize=(9, 4))\n",
"        plt.plot(t_vals, a, label="a(t)")\n",
"        plt.plot(t_vals, adot, label="a'(t)")\n",
"        plt.title("Module A downstream cosmology proxy")\n",
"        plt.legend()\n",
"        plt.tight_layout()\n",
"        plt.show()\n",
"        print(f"Final a({tmax}) = {a[-1]:.6f}")\n",
"        print(f"Final a'({tmax}) = {adot[-1]:.6f}")\n",
"\n",
"    elif mod == "B":\n",
"        eps = cfg.get("epsilon", packet_value("epsilon", 0.000108071))\n",
"        lam = cfg.get("lambdaNormalized", packet_value("lambdaNormalized", 0.489442))\n",
"        theta = eps * np.sin(lam * t_vals)\n",
"        plt.figure(figsize=(9, 4))\n",
"        plt.plot(t_vals, theta)\n",
"        plt.title("Module B downstream CP phase: epsilon sin(lambda t)")\n",
"        plt.xlabel("t")\n",
"        plt.ylabel("Theta(t)")\n",
"        plt.tight_layout()\n",
"        plt.show()\n",
"        print(f"Theta max = {np.max(np.abs(theta)):.9g}")\n",
"        print(f"Theta mean absolute = {np.mean(np.abs(theta)):.9g}")\n",
"\n",
"    elif mod == "D":\n",
"        S = recursive_entropy(t_vals, delta, alpha, packet_value("nClosure", 18))\n",
"        psi = recursive_kernel(t_vals, delta, alpha, nu, n)\n",
"        plt.figure(figsize=(9, 4))\n",
"        plt.plot(t_vals, S, label="S_rec(t)")\n",
"        plt.plot(t_vals, psi, label="psi(t)")\n",
"        plt.title("Module D entropy and identity kernel")\n",
"        plt.legend()\n",
"        plt.tight_layout()\n",
"        plt.show()\n",
"        print(f"Final S_rec = {S[-1]:.6g}")\n",
"        print(f"Final psi = {psi[-1]:.6g}")\n",
"\n",
"    elif mod == "J":\n",
"        eps = cfg.get("epsilon", packet_value("epsilon", 0.000108071))\n",
"        psi1 = recursive_kernel(t_vals, delta, alpha, nu, n)\n",
"        psi2 = recursive_kernel(t_vals, delta, alpha, nu + eps, n)\n",
"        lam_div = np.log(1 + np.abs(psi1 - psi2))\n",
"        plt.figure(figsize=(9, 4))\n",
"        plt.plot(t_vals, lam_div)\n",
"        plt.title("Module J observer branch divergence")\n",
"        plt.xlabel("t")\n",
"        plt.ylabel("lambda_div(t)")\n",
"        plt.tight_layout()\n",
"        plt.show()\n",
"        print(f"Max lambda_div = {lam_div.max():.9g}")\n",
"\n",
"    elif mod == "K":\n",
"        psi_rebirth = recursive_kernel(t_vals, delta, alpha, nu, n, mode="rebirth")\n",
"        plt.figure(figsize=(9, 4))\n",
"        plt.plot(t_vals, psi_rebirth)\n",
"        plt.title("Module K collapse-rebirth field")\n",
"        plt.xlabel("t")\n",
"        plt.ylabel("psi_rebirth(t)")\n",
"        plt.tight_layout()\n",
"        plt.show()\n",
"        print(f"Initial psi_rebirth = {psi_rebirth[0]:.9g}")\n",
"        print(f"Final psi_rebirth = {psi_rebirth[-1]:.9g}")\n",
"\n",
"    elif mod == "M":\n",
"        psi = recursive_kernel(t_vals, delta, alpha, nu, n)\n",
"        dpsi = np.gradient(psi, t_vals)\n",
"        E = dpsi ** 2 + psi ** 2\n",
"        m = np.sqrt(np.mean(psi ** 2))\n",
"        plt.figure(figsize=(9, 4))\n",
"        plt.plot(t_vals, E)\n",
"        plt.title("Module M recursive energy curve")\n",
"        plt.xlabel("t")\n",
"        plt.ylabel("E(t)")\n",
"        plt.tight_layout()\n",
"        plt.show()\n",
"        print(f"RMS mass m(nu) = {m:.9g}")\n",
"        print(f"Mean energy = {np.mean(E):.9g}")\n",
"\n",
"    else:\n",
"        # Generic downstream kernel view\n",
"        psi = recursive_kernel(t_vals, delta, alpha, nu, n)\n",
"        plt.figure(figsize=(9, 4))\n",
"        plt.plot(t_vals, psi)\n",
"        plt.title(f"Module {mod} downstream recursive kernel view")\n",
"        plt.xlabel("t")\n",
"        plt.ylabel("psi(t)")\n",
"        plt.tight_layout()\n",
"        plt.show()\n",
"        print(f"psi min = {psi.min():.9g}")\n",
"        print(f"psi max = {psi.max():.9g}")\n",
"        print(f"psi RMS = {np.sqrt(np.mean(psi ** 2)):.9g}")\n",
"\n",
