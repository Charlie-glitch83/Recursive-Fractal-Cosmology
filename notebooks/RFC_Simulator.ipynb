"def canonical_sort_key(name):\n",
"    order = {\n",
"        "G": 0,\n",
"        "R": 1,\n",
"        "N": 2,\n",
"        "S": 3,\n",
"        "T": 4,\n",
"        "A": 10,\n",
"        "B": 11,\n",
"        "C": 12,\n",
"        "D": 13,\n",
"        "E": 14,\n",
"        "F": 15,\n",
"        "H": 16,\n",
"        "I": 17,\n",
"        "J": 18,\n",
"        "K": 19,\n",
"        "L": 20,\n",
"        "M": 21,\n",
"        "O": 22,\n",
"        "P": 23,\n",
"        "Q": 24,\n",
"        "G_legacy": 90,\n",
"        "N_legacy": 91,\n",
"        "R_legacy": 92\n",
"    }\n",
"    return (order.get(name, 50), name)\n",
"\n",
"\n",
"module_options = sorted([module_key(cfg) for cfg in all_configs], key=canonical_sort_key)\n",
"module_selector = Dropdown(\n",
"    options=module_options,\n",
"    value="G" if "G" in module_options else module_options[0],\n",
"    description="Module:",\n",
"    layout=Layout(width="420px")\n",
")\n",
"run_button = Button(description="Run selected module", button_style="primary")\n",
"out = Output()\n",
"\n",
"\n",
"def run_simulation(selected_module):\n",
"    cfg = get_config(selected_module)\n",
"    mod = cfg.get("module")\n",
"    if mod == "G":\n",
"        run_module_G(cfg)\n",
"    elif mod == "R":\n",
"        run_module_R(cfg)\n",
"    elif mod == "N":\n",
"        run_module_N(cfg)\n",
"    elif mod == "S":\n",
"        run_module_S(cfg)\n",
"    elif mod == "T":\n",
"        run_module_T(cfg)\n",
"    elif str(mod).endswith("legacy") or cfg.get("currentStatus", "").startswith("deprecated"):\n",
"        run_legacy_warning(cfg)\n",
"    else:\n",
"        run_downstream_module(cfg)\n",
"\n",
"\n",
"def on_run_clicked():\n",
"    out.clear_output(wait=True)\n",
"    with out:\n",
"        run_simulation(module_selector.value)\n",
"\n",
"\n",
"run_button.on_click(on_run_clicked)\n",
"display(VBox([module_selector, run_button, out]))\n",
"\n",
"display(Markdown("Select a module and click Run selected module. Start with G, then R, N, S, and T."))\n"
]
